# 统一换行符：仓库内一律 LF，检出/提交时自动转换
# Windows 编辑器（IDEA/VS Code）已配置换行也无需手动改
* text=auto eol=lf

# 明确文本类型的常见文件
*.md   text eol=lf
*.json text eol=lf
*.sh   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.txt  text eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
